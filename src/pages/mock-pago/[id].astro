---
import Layout from "../../layouts/Layout.astro";
import { getOrderStore } from "../../lib/orders.js";
export const prerender = false;

const order = await getOrderStore().get(Astro.params.id!);
if (!order) return Astro.redirect("/");
---

<Layout>
  <main class="page">
    <p class="notice">⚠️ Pasarela simulada. No se cobra nada.</p>
    <h1 class="title">
      Pagar {
        order.total.toLocaleString("es-CL", {
          style: "currency",
          currency: "CLP",
        })
      }
    </h1>
    <form method="POST" action="/api/mock-webhook" class="actions">
      <input type="hidden" name="orderId" value={order.id} />
      <button name="result" value="paid" class="btn btn--paid">
        ✅ Aprobar pago
      </button>
      <button name="result" value="rejected" class="btn btn--rejected">
        ❌ Rechazar pago
      </button>
      <button name="result" value="pending" class="btn btn--pending">
        ⏳ Dejar pendiente
      </button>
    </form>
  </main>
</Layout>

<style>
  .page,
  .page * {
    box-sizing: border-box;
  }

  .page {
    max-width: 28rem; /* max-w-md */
    margin-inline: auto; /* mx-auto */
    padding: 1.5rem; /* p-6 */
    display: flex;
    flex-direction: column;
    gap: 1rem; /* space-y-4 */
  }

  .notice {
    margin: 0;
    padding: 0.5rem; /* p-2 */
    border-radius: 0.25rem;
    background: #fef9c3; /* bg-yellow-100 */
    font-size: 0.875rem; /* text-sm */
    line-height: 1.25rem;
  }

  .title {
    margin: 0;
    font-size: 1.5rem; /* text-2xl */
    line-height: 2rem;
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem; /* gap-2 */
  }

  .btn {
    padding: 0.75rem; /* p-3 */
    border: 0;
    border-radius: 0.25rem;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  .btn--paid {
    background: #16a34a; /* bg-green-600 */
  }
  .btn--rejected {
    background: #dc2626; /* bg-red-600 */
  }
  .btn--pending {
    background: #6b7280; /* bg-gray-500 */
  }
</style>
