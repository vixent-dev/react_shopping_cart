---
// @ts-nocheck
import Layout from "../../layouts/Layout.astro";
import RecentlyViewed from "../../components/RecentlyViewed.jsx";
import AddToCartButton from "../../components/AddToCartButton.jsx";
import { ProductTracker } from "../../components/ProductTracker.jsx";
import { getProducts } from "../../lib/products.js";
export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { id: product.id.toString() },
    props: { product },
  }));
}
const { product } = Astro.props;
---

<Layout>
  <section data-product={JSON.stringify(product)}>
    <div class="image">
      <img src={product.image} alt={product.title} />
    </div>
    <div class="product-info">
      <div>
        <h1>{product.title}</h1>
        <h3>{product.category}</h3>
      </div>
      <div>
        <h2>${product.price}</h2>
      </div>
      <p>{product.description}</p>
      <AddToCartButton client:load product={product} />
    </div>
  </section>
  <ProductTracker client:load product={product} />
  <RecentlyViewed client:visible />
</Layout>

<style>
  section {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 100px;
    margin-inline: 5em;
    margin-bottom: 2em;
  }

  @media (width < 640px) {
    section {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: 20px;
    }
  }

  .image {
    aspect-ratio: 1 / 1;
    width: 100%;
    border: 1px solid lightgray;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1em;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
  }

  h1 {
    font-size: 2rem;
  }

  h2 {
    font-size: 3rem;
    margin-block: 0.25em;
  }

  h3 {
    font-size: 1.5rem;
  }

  p {
    font-size: 1.25rem;
    margin-bottom: 2em;
  }
</style>
